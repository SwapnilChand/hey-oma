#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["vosk", "piper-tts"]
# ///
"""hey-oma: say "hey oma <command>" and it runs. Offline (Vosk), no LLM.

Edit COMMANDS to add phrases, REPLIES for what oma says back.
`hey-oma --warm` pre-generates every reply in your voice; `hey-oma --test` runs the self-check.
"""
import base64, difflib, json, os, re, subprocess, sys, threading, time, urllib.error, urllib.parse, urllib.request, wave

MODEL = os.path.expanduser("~/.local/share/hey-oma/model")
# "hey oma" plus any extra wake phrases you list in this file, one per line (e.g. "hey goose")
WAKE_FILE = os.path.expanduser("~/.config/hey-oma/wake-words")
WAKES = ["hey oma"] + ([l.strip().lower() for l in open(WAKE_FILE) if l.strip()] if os.path.exists(WAKE_FILE) else [])
MPRIS = "busctl --user call org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player"
WEB = "omarchy-launch-webapp"
CLOSE = "hyprctl dispatch 'hl.dsp.window.close"  # Hyprland 0.56+ Lua dispatch


def close(cls):
    return f"""{CLOSE}({{ window = \"class:^({cls.replace('.', '[.]')})$\" }})'"""

# spoken phrase (after the wake word) -> shell command. Only words the model knows work.
COMMANDS = {
    "play spotify": "omarchy-launch-or-focus spotify",
    "open spotify": "omarchy-launch-or-focus spotify",
    "play music": f"{MPRIS} Play",
    "pause music": f"{MPRIS} Pause",
    "pause": f"{MPRIS} Pause",
    "next song": f"{MPRIS} Next",
    "previous song": f"{MPRIS} Previous",
    "open browser": "omarchy-launch-browser",
    "open terminal": "uwsm-app -- xdg-terminal-exec",
    "open editor": "omarchy-launch-editor",
    "open obsidian": 'omarchy-launch-or-focus ^obsidian$ "uwsm-app -- obsidian"',
    "open youtube": f'{WEB} "https://youtube.com/"',
    "open email": f'{WEB} "https://app.hey.com"',
    "open calendar": f'{WEB} "https://app.hey.com/calendar/weeks/"',
    "open chat": f'{WEB} "https://chatgpt.com"',
    "close window": f"{CLOSE}()'",  # whatever is focused
    "close spotify": close("Spotify"),
    "close browser": close("chromium"),  # one window per call
    "close youtube": close("chrome-youtube.com__-Default"),
    "close chat": close("chrome-chatgpt.com__-Default"),
    "close obsidian": close("obsidian"),
}
# "hey oma play <anything else>" -> search Spotify for it. Optional creds file makes it auto-play.
CREDS = os.path.expanduser("~/.config/hey-oma/spotify.env")  # SPOTIFY_CLIENT_ID=.. / SPOTIFY_CLIENT_SECRET=..


def after_wake(text):
    """'hey oma open browser' -> 'open browser'; None if it doesn't start with a wake phrase."""
    text = " ".join(text.split())
    for wake in WAKES:
        if text == wake or text.startswith(wake + " "):
            return text[len(wake):].strip()
    return None


def match(text):
    """Final transcript -> command, or None if no wake word / unknown phrase."""
    return COMMANDS.get(after_wake(text) or "")


ON_YOUTUBE = re.compile(r"\s*\b(on |in )?(youtube|you tube|yt|y t)$")


def parse_play(text, skip=3):
    """'Hey Goose, play Goosiest on YT.' -> ('goosiest', 'youtube'); 'play shape of you' -> (.., 'spotify').
    If 'play' was misheard ('slay'), drop the first `skip` words (wake phrase + 'play'). None if no name."""
    t = " ".join(re.sub(r"[^\w\s']", " ", text.lower()).split())
    _, sep, rest = t.partition("play ")
    rest = rest if sep else " ".join(t.split()[skip:])
    where = "youtube" if ON_YOUTUBE.search(rest) else "spotify"
    rest = re.sub(r"^the ", "", ON_YOUTUBE.sub("", rest)).strip()
    return (rest, where) if rest else None


def transcribe(pcm, model):
    """Accurate text for a 'play …' utterance: Superwhisper if installed, else Vosk (full vocabulary)."""
    path = os.path.expanduser("~/.local/share/hey-oma/utterance.wav")
    with wave.open(path, "wb") as w:
        w.setnchannels(1), w.setsampwidth(2), w.setframerate(16000), w.writeframes(pcm)
    try:
        run = lambda *a: subprocess.run(["superwhisper", *a], capture_output=True, text=True, timeout=5).stdout
        sid = json.loads(run("transcribe", path))["session_id"]
        for _ in range(60):  # transcribe is async; `read` returns null until it's done
            r = json.loads(run("read") or "null")
            if r and r.get("session_id") == sid and r.get("text") is not None:
                return r["text"]
            time.sleep(0.25)
    except Exception as e:
        print(f"superwhisper: {e!r}", flush=True)
    import vosk
    rec = vosk.KaldiRecognizer(model, 16000)
    rec.AcceptWaveform(pcm)
    return json.loads(rec.FinalResult()).get("text", "")


def yt(*args):
    return subprocess.run(["yt-dlp", "--no-warnings", "--flat-playlist", *args],
                          capture_output=True, text=True, timeout=20).stdout.split("\n")[0]


def play_youtube(query):
    """A channel name -> its latest upload; anything else -> the top video. Opens in the YouTube web app."""
    latest = query.startswith("latest ")
    query = query.removeprefix("latest ").strip()
    url, what = "https://www.youtube.com/results?" + urllib.parse.urlencode({"search_query": query}), query
    try:
        vid, channel, channel_url = yt("--print", "%(id)s\t%(channel)s\t%(channel_url)s", f"ytsearch1:{query}").split("\t")
        url = f"https://www.youtube.com/watch?v={vid}"
        squash = lambda x: re.sub(r"\W", "", x.lower())
        if latest or difflib.SequenceMatcher(None, squash(channel), squash(query)).ratio() >= 0.8:
            url, what = f"https://www.youtube.com/watch?v={yt('-I', '1', '--print', '%(id)s', channel_url + '/videos')}", f"the latest from {channel}"
    except Exception as e:  # no yt-dlp / network: fall back to the search page
        print(f"yt-dlp: {e!r}", flush=True)
    notify(f"playing {what}")
    subprocess.Popen([WEB, url], start_new_session=True)


def handle_play(pcm, model, skip):
    text = transcribe(pcm, model)
    parsed = parse_play(text, skip)
    print(f"play: {text!r} -> {parsed}", flush=True)
    if not parsed:
        return notify(SORRY)
    query, where = parsed
    play_youtube(query) if where == "youtube" else play_song(query)


def spotify_track(query):
    """Top track URI via Spotify Web API (client credentials), or None without creds/on error."""
    try:
        env = dict(l.strip().split("=", 1) for l in open(CREDS) if "=" in l)
        auth = base64.b64encode(f"{env['SPOTIFY_CLIENT_ID']}:{env['SPOTIFY_CLIENT_SECRET']}".encode()).decode()
        req = urllib.request.Request("https://accounts.spotify.com/api/token", b"grant_type=client_credentials",
                                     {"Authorization": f"Basic {auth}"})
        token = json.load(urllib.request.urlopen(req, timeout=5))["access_token"]
        url = "https://api.spotify.com/v1/search?" + urllib.parse.urlencode({"q": query, "type": "track", "limit": 1})
        items = json.load(urllib.request.urlopen(
            urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"}), timeout=5))["tracks"]["items"]
        return items[0]["uri"] if items else None
    except Exception as e:  # missing creds, network, API change -> fall back to search page
        print(f"spotify api: {e!r}", flush=True)
        return None


def play_song(query):
    if subprocess.run(f"{MPRIS.split(' /')[0]} /org/mpris/MediaPlayer2 org.freedesktop.DBus.Peer Ping",
                      shell=True, capture_output=True).returncode:
        subprocess.Popen("omarchy-launch-or-focus spotify", shell=True, start_new_session=True)
        time.sleep(4)  # ponytail: fixed wait for Spotify cold start; poll D-Bus if it's flaky
    uri = spotify_track(query) or "spotify:search:" + urllib.parse.quote(query)
    notify(f"{'playing' if 'track' in uri else 'searching for'} {query}")
    subprocess.run(f"{MPRIS} OpenUri s {json.dumps(uri)}", shell=True)


VERBS = {"open": "opening", "close": "closing", "play": "playing", "pause": "pausing"}
# hand-written replies win over the verb rule; add lines here, then run `hey-oma --warm`
REPLIES = {
    "pause": "paused", "pause music": "paused", "play music": "resuming",
    "next song": "skipping", "previous song": "going back",
    "play spotify": "opening spotify", "close window": "closing it",
}
ACK = "yaa?"  # said when you only say the wake word; then the next 8s take a command without it
SORRY = "sorry, I didn't catch that"
EXTRA = [SORRY, ACK]  # other lines to pre-generate
# One folder per voice. Files are named by their text, so you can drop in your own recordings.
REPLY_DIR = os.path.expanduser("~/.local/share/hey-oma/replies")
PIPER_VOICE = os.path.expanduser("~/.local/share/hey-oma/voice/en_US-amy-medium.onnx")
_piper = None
_cartesia_ok = True  # flips off after a 4xx so we don't wait on it every time


def reply(phrase):
    """'open browser' -> 'opening browser' (what oma says back)."""
    if phrase in REPLIES:
        return REPLIES[phrase]
    verb, _, rest = phrase.partition(" ")
    return f"{VERBS[verb]} {rest}".strip() if verb in VERBS else phrase


def read_env(path):
    return dict(l.strip().split("=", 1) for l in open(os.path.expanduser(path)) if "=" in l)


def cartesia_wav(text, path):
    env = read_env("~/.config/hey-oma/cartesia.env")  # CARTESIA_API_KEY / CARTESIA_VOICE_ID
    body = {"model_id": "sonic-3", "transcript": text, "language": "en",
            "voice": {"mode": "id", "id": env["CARTESIA_VOICE_ID"]},
            "output_format": {"container": "wav", "encoding": "pcm_s16le", "sample_rate": 44100}}
    req = urllib.request.Request("https://api.cartesia.ai/tts/bytes", json.dumps(body).encode(), {
        "X-API-Key": env["CARTESIA_API_KEY"], "Cartesia-Version": "2025-04-16", "Content-Type": "application/json"})
    audio = urllib.request.urlopen(req, timeout=8).read()
    with open(path, "wb") as f:
        f.write(audio)


def piper_wav(text, path):
    global _piper
    from piper import PiperVoice
    _piper = _piper or PiperVoice.load(PIPER_VOICE)  # ~1s once, then ~0.1s per phrase
    with wave.open(path, "wb") as w:
        _piper.synthesize_wav(text, w)


def reply_file(text, play=True):
    """Cartesia (your voice) -> local Piper -> None. Each result saved as <engine>/<text>.wav."""
    global _cartesia_ok
    name = "".join(c for c in text.lower() if c.isalnum() or c in " -'").strip() + ".wav"
    for engine, make in (("cartesia", cartesia_wav), ("piper", piper_wav)):
        path = os.path.join(REPLY_DIR, engine, name)
        if os.path.exists(path):
            return path
        if make is cartesia_wav and not _cartesia_ok:
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        try:
            make(text, path)
            return path
        except Exception as e:
            print(f"tts {engine}: {e!r}", flush=True)
            if isinstance(e, urllib.error.HTTPError) and 400 <= e.code < 500:
                _cartesia_ok = False
            if os.path.exists(path):
                os.remove(path)
    return None


def speak(text):
    path = reply_file(text)
    # loudnorm: every reply plays at the same loudness, however quiet the voice or recording was
    subprocess.run(["mpv", "--no-video", "--really-quiet", "--af=lavfi=[loudnorm=I=-14:TP=-1.5:LRA=11]", path]
                   if path else ["espeak-ng", text])


def warm():
    """Pre-generate every fixed reply, so speaking never needs the network."""
    for line in sorted({reply(p) for p in COMMANDS} | set(EXTRA)):
        print(line, "->", reply_file(line))


def notify(msg):
    subprocess.Popen(["notify-send", "-t", "1500", "hey oma", msg])
    threading.Thread(target=speak, args=(msg,), daemon=True).start()  # don't stall the mic loop


def listen():
    import vosk
    vosk.SetLogLevel(-1)
    rate = 16000
    # Grammar = only our phrases (+ [unk] so other speech is rejected, not forced into a match).
    phrases = list(COMMANDS) + ["play [unk]"]
    grammar = json.dumps([f"{w} {p}" for w in WAKES for p in phrases] + phrases + ["[unk]"])
    model = vosk.Model(MODEL)
    rec = vosk.KaldiRecognizer(model, rate, grammar)
    utt = bytearray()  # audio since the last final result = the current utterance
    awake_until = 0.0  # after ACK, a bare command (no wake word) is accepted until this time
    mic = subprocess.Popen(
        ["pw-record", "--rate", str(rate), "--channels", "1", "--format", "s16", "-"],
        stdout=subprocess.PIPE,
    )
    print(f"listening… say {' / '.join(WAKES)} + a command", flush=True)
    while chunk := mic.stdout.read(4000):
        utt += chunk
        if not rec.AcceptWaveform(chunk):
            continue
        pcm, utt = bytes(utt), bytearray()
        text = json.loads(rec.Result()).get("text", "")
        rest = after_wake(text)
        if rest is None and time.time() < awake_until and text and "[unk]" != text:
            rest = text  # the command that follows "yaa?"
        if rest is None:  # background noise is force-fit every ~20s (Kaldi max utterance); ignore it
            continue
        awake_until = 0.0
        if rest == "":  # just the wake word
            print(f"heard: {text!r} -> {ACK}", flush=True)
            notify(ACK)
            awake_until = time.time() + 8
            continue
        cmd = COMMANDS.get(rest)
        print(f"heard: {text!r} -> {cmd}", flush=True)
        if not cmd and rest.startswith("play"):
            # grammar heard "hey oma play [unk]": transcribe this utterance properly, off the mic loop
            skip = len(text.split()) - len(rest.split()) + 1
            threading.Thread(target=handle_play, args=(pcm, model, skip), daemon=True).start()
        elif cmd:
            notify(reply(rest))
            subprocess.Popen(cmd, shell=True, start_new_session=True)
        else:  # wake word but no known command
            notify(SORRY)


def test():
    assert match("hey oma play spotify") == COMMANDS["play spotify"]
    assert match("  hey oma   next song ") == COMMANDS["next song"]
    assert match("play spotify") is None          # no wake word
    assert match("hey oma [unk]") is None         # unknown phrase
    assert match("") is None
    assert match("hey omar open browser") is None   # wake word must be whole words
    WAKES.append("hey goose")
    assert match("hey goose open browser") == COMMANDS["open browser"]
    assert after_wake("hey goose play shape of you") == "play shape of you"
    WAKES.remove("hey goose")
    assert match("hey oma close spotify") == """hyprctl dispatch 'hl.dsp.window.close({ window = "class:^(Spotify)$" })'"""
    assert parse_play("hey oh ma play shape of you") == ("shape of you", "spotify")
    assert parse_play("Hey Goose, play Goosiest on YT.") == ("goosiest", "youtube")
    assert parse_play("hey goose play the latest goosiest on YouTube") == ("latest goosiest", "youtube")
    assert parse_play("play lofi on you tube") == ("lofi", "youtube")
    assert parse_play("play don't stop me now") == ("don't stop me now", "spotify")
    assert parse_play("how you slay shame on you") == ("shame on you", "spotify")
    assert parse_play("hey oma play ") is None
    assert parse_play("play on youtube") is None
    assert parse_play("play goosiest in yt") == ("goosiest", "youtube")
    assert reply("open browser") == "opening browser"
    assert reply("pause") == "paused"
    assert reply("next song") == "skipping"
    assert reply("close spotify") == "closing spotify"
    print("ok")


if __name__ == "__main__":
    test() if "--test" in sys.argv else warm() if "--warm" in sys.argv else listen()
